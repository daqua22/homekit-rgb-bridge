{
  "name": "homekit-rgb-bridge",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Control your PC's RGB lighting through Apple Home. A standalone, open-source HomeKit bridge for Windows.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Daniil Kozar",
    "url": "https://kozar.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/daqua22/homekit-rgb-bridge.git"
  },
  "engines": {
    "node": "^22.15.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "package:preview": "node scripts/package.mjs",
    "package:verify": "node scripts/verify-package.mjs",
    "licenses": "node scripts/licenses.mjs && prettier --write THIRD_PARTY_NOTICES.md docs/dependency-licenses.md",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@homebridge/hap-nodejs": "2.2.3",
    "qrcode-terminal": "0.12.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/qrcode-terminal": "^0.12.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
